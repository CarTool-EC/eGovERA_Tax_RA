              <child xsi:type="archimate:DiagramObject" id="id-004c00e8459443cebc47d11932956a32" targetConnections="id-074d6d0216b04684ade89b6795a8b3c2" font="1|Segoe UI|9.0|3|WINDOWS|1|0|0|0|0|700|1|0|0|1|0|0|0|0|Segoe UI" textPosition="1" archimateElement="id-a23c0e3accb34d8eaaacbbd792f8f21e">
