    <element xsi:type="archimate:Requirement" name="National Schema on VAT" id="id-3c3608c3d9b049e2b2a008daaf1861e6">
      <documentation>DESCRIPTION:&#xD;
National Legal act that regulates the consumption tax assessed on the value added to goods and services.</documentation>
      <property key="dct:modified" value="2023-11-20"/>
      <property key="dct:spatial" value="National"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/NationalSchemaOnVATRequirement"/>
      <property key="dct:title" value="National Schema on VAT"/>
      <property key="skos:example" value="For instance, in the UK, the standard VAT rate is 20%, which is within the EU's stipulated range of 15-25%. Certain goods and services, such as children's car seats and home energy, are taxed at a reduced rate of 5%. Zero-rated goods and services, such as most food and children's clothes, are also outlined in the UK's national VAT regulation, in line with the EU's VAT Directive."/>
      <property key="skos:note" value="The National Schema on VAT Regulation is a crucial part of the EU's fiscal policy, aiming to harmonize tax laws across member states and ensure a fair and efficient taxation system. Each member state has the autonomy to set their own VAT rates within the parameters set by the EU, and must ensure that their national laws align with the EU's VAT Directive."/>
      <property key="skos:definition" value="The national regulation on VAT within the member states of the European Union is a set of rules and guidelines that each member state must follow in order to comply with the EU's overarching VAT Directive. This regulation outlines the standard rate of VAT that should be applied, as well as the reduced rates for certain goods and services. It also provides guidelines on how VAT should be collected, reported, and paid to the relevant authorities."/>
      <property key="eira:definitionSource" value="European Union"/>
      <property key="eira:definitionSourceReference" value="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32006L0112"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:concept" value="eira:ArchitectureBuildingBlock"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="dct:type" value="egovera:NationalSchemaOnVATRequirement"/>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/NationalSchemaOnVATRequirement"/>
      <property key="eira:businessDomain" value="taxes"/>
      <property key="skos:broader" value="http://data.europa.eu/dr8/BindingInstrumentRequirement"/>
    </element>
    <element xsi:type="archimate:Requirement" name="Commission Recommendation 87/598/EEC of 8 December 1987" id="id-3cd60e22267e47af9fb267757e47af7a">
      <documentation>Description: The European Code of Conduct relating to electronic payment is a set of guidelines and principles established by the European Commission to ensure fair and transparent practices in electronic payment services. It aims to protect consumers by promoting secure and efficient payment systems, enhancing competition, and preventing fraud and abuse. The code encourages payment service providers to provide clear information to consumers regarding fees, charges, and terms of service, as well as ensuring the security and privacy of personal data. It also promotes interoperability and accessibility of payment systems across the European Union.

Publisher: EUR-Lex

Source: http://data.europa.eu/eli/reco/1987/598/oj

Last modification: 26/06/2023

