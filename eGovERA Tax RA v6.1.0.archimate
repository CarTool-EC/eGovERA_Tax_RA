    <element xsi:type="archimate:Requirement" name="Action plan to strengthen the fight against tax fraud, tax avoidance, and tax evasion" id="id-f2becc87552b44b5b9d2f6f0419e7a6f">
      <documentation>DESCRIPTION:&#xD;
&quot;Communication from the Commission to the European Parliament and the Council for the definition of a common Action Plan to strengthen the fight against tax fraud and tax evasion.
&quot;</documentation>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:spatial" value="EU"/>
      <property key="dct:identifier" value="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52012DC0352"/>
      <property key="dct:title" value="Action plan to strengthen the fight against tax fraud, tax avoidance, and tax evasion"/>
      <property key="dct:description" value="This action plan is a comprehensive strategy developed by the European Union to combat tax fraud, tax evasion, and tax avoidance. It aims to ensure that everyone pays their fair share of taxes, to protect the integrity of tax systems, and to promote economic fairness and social justice. The plan includes measures to improve tax transparency, ensure fair taxation for businesses, and create a more effective EU framework for dealing with tax fraud and evasion."/>
      <property key="dct:publisher" value="EUR-Lex"/>
      <property key="dct:source" value="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52012DC0352"/>
      <property key="skos:example" value="An example of applying this regulation is the implementation of the Common Reporting Standard (CRS) within the EU, which requires financial institutions to exchange information about their customers' financial accounts. This helps to prevent tax evasion by making it more difficult for individuals and businesses to hide their income and assets in offshore accounts. Another example is the introduction of the Anti-Tax Avoidance Directive (ATAD), which sets out anti-abuse measures that all EU countries must apply to deter multinational companies from exploiting tax rules to avoid paying taxes."/>
      <property key="skos:note" value="The action plan is a part of the EU's broader effort to promote tax fairness and financial transparency. It includes 34 measures that will be implemented over the next several years. These measures include improving cooperation between tax authorities, increasing transparency for multinational companies, and strengthening the EU's ability to respond to tax fraud and evasion. The plan also includes measures to ensure that digital companies pay their fair share of taxes and to create a single EU VAT area to simplify VAT rules for businesses."/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="eira:businessDomain" value="taxes"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/Non-bindingInstrumentRequirement"/>
    </element>
    <element xsi:type="archimate:Requirement" name="National Schema on Co2 (carbon) related taxes" id="id-f4c7f31eb61b4cdcb75e11e7cf2a8774">
      <documentation>DESCRIPTION:&#xD;
National legal act receiving a european directive with the aim to drastically reduce the emission of Co2. &#xD;
</documentation>
      <property key="dct:modified" value="2023-11-20"/>
      <property key="dct:spatial" value="National"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/NationalSchemaOnCo2RelatedTaxesRequirement"/>
      <property key="dct:title" value="National Schema on Co2 (carbon) related taxes"/>
      <property key="skos:example" value="For instance, Sweden has one of the highest carbon taxes in the world, which has significantly reduced the country's carbon emissions. On the other hand, Ireland applies a flat rate carbon tax across all fuels, which has been gradually increased over the years to encourage a shift towards cleaner energy sources."/>
      <property key="skos:note" value="The regulation allows each member state to set its own carbon tax rate, but it must be in line with the EU's overall climate goals. The tax is typically applied to the carbon content of fossil fuels, but it can also be applied to the greenhouse gas emissions of certain sectors. The aim of the tax is to incentivize businesses and individuals to reduce their carbon emissions and to fund renewable energy projects."/>
      <property key="skos:definition" value="The national regulation on CO2 related taxes within the member states of the European Union is a framework that guides the implementation of carbon taxation. This regulation is designed to reduce carbon emissions by imposing a tax on the carbon content of fossil fuels or on the greenhouse gas emissions of certain sectors. The tax rate is typically set per tonne of CO2 emitted, and the revenue generated is often used to fund renewable energy projects or to reduce other taxes."/>
      <property key="eira:definitionSource" value="European Union"/>
      <property key="eira:definitionSourceReference" value="https://ec.europa.eu/taxation_customs/business/excise-duties-alcohol-tobacco-energy/excise-duties-energy/taxation-energy-products-electricity_en"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:concept" value="eira:ArchitectureBuildingBlock"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="dct:type" value="egovera:NationalSchemaOnCo2RelatedTaxesRequirement"/>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/NationalSchemaOnCo2RelatedTaxesRequirement"/>
      <property key="eira:businessDomain" value="taxes"/>
      <property key="skos:broader" value="http://data.europa.eu/dr8/BindingInstrumentRequirement"/>
    </element>
    <element xsi:type="archimate:Requirement" name="Recommendation on a trusted and secure European e-ID" id="id-f4dda2766a34449e853654a5091df79b">
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:title" value="Commission Recommendation of 3.6.2021 on a common Union Toolbox for a coordinated approach towards a European Digital Identity Framework"/>
      <property key="dct:description" value="The Commission Recommendation of 3.6.2021 on a common Union Toolbox for a coordinated approach towards a European Digital Identity Framework aims to establish a trusted and secure European e-ID system. It proposes a set of guidelines and tools to ensure the interoperability, security, and privacy of digital identities across the European Union. The framework emphasizes the use of decentralized and user-centric solutions, enabling individuals to have control over their personal data while facilitating seamless and secure access to online services. The recommendation also highlights the importance of international cooperation and standards to ensure the global recognition and acceptance of European digital identities."/>
      <property key="dct:source" value="https://digital-strategy.ec.europa.eu/en/library/recommendation-building-joint-cyber-unit"/>
      <property key="dct:identifier" value="https://eur-lex.europa.eu/eli/reco/2021/946/oj"/>
      <property key="eira:view" value="LV-Architecture Principles"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/Non-bindingInstrumentRequirement"/>
    </element>
    <element xsi:type="archimate:Requirement" name="Directive (EU) 2016/97 of the European Parliament and of the Council of 20 January 2016" id="id-f67c9ab50f4046a29401991a2c1e3631">
      <documentation>Description: Directive (EU) 2016/97, also known as the Insurance Distribution Directive (IDD), is a European Union directive that aims to harmonize the rules and regulations governing the distribution of insurance products across member states. The directive sets out requirements for insurance distributors, including insurance intermediaries and insurance undertakings, in terms of their professional knowledge, conduct, and transparency towards customers. It also introduces new rules on product oversight and governance, disclosure of information, and the handling of complaints. The IDD seeks to enhance consumer protection, promote fair competition, and ensure a level playing field for insurance distributors operating within the EU.

Publisher: EUR-Lex

Source: http://data.europa.eu/eli/dir/2016/97/2020-06-12

Last modification: 26/06/2023

EIRA traceability: eira:BindingInstrumentRequirement

LOST view: Legal view - Binding Power and Jurisdiction

EIRA concept: eira:SolutionBuildingBlock

Additional identifier: http://data.europa.eu/eli/dir/2016/97/2020-06-12

Title: Directive (EU) 2016/97 of the European Parliament and of the Council of 20 January 2016 on insurance distribution (recast)

</documentation>
