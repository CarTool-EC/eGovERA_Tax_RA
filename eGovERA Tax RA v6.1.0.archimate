            <child xsi:type="archimate:DiagramObject" id="id-39fc6104dee2493ea4dd958aec9881e1" targetConnections="id-dc41a656f2d84ccb9d7774545234e4ed" font="1|Segoe UI|9.0|3|WINDOWS|1|0|0|0|0|700|1|0|0|1|0|0|0|0|Segoe UI" textPosition="1" archimateElement="id-313a04f84a094a0982d50675ab2f978c">
