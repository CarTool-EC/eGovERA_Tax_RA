    <element xsi:type="archimate:DataObject" name="Data Contract" id="id-c66cd4a50ada4357b7bb23da5d4ec019">
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/DataContractDataObject"/>
      <property key="dct:modified" value="2023-11-20"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/DataContractDataObject"/>
      <property key="dct:type" value="egovera:DataContractDataObject"/>
      <property key="dct:title" value="Data Contract Data-object"/>
      <property key="skos:definition" value="A Data Contract, within the realm of European tax regulations, refers to a formal agreement that stipulates the terms and conditions under which personal and financial data is collected, processed, shared, and stored by entities such as businesses, tax authorities, and financial institutions. This contract ensures compliance with data protection laws, such as the General Data Protection Regulation (GDPR), by establishing clear guidelines on data handling practices, the rights of individuals whose data is being processed, and the obligations of the data processors and controllers. The aim is to safeguard taxpayer information, maintain privacy, and ensure the integrity and security of data exchanges, particularly in cross-border transactions where multiple jurisdictions are involved."/>
      <property key="eira:definitionSource" value="EIRA team"/>
      <property key="eira:definitionSourceReference"/>
      <property key="skos:example"/>
      <property key="eira:concept" value="eira:ArchitectureBuildingBlock"/>
      <property key="skos:note"/>
      <property key="eira:eifLayer" value="Semantic"/>
      <property key="skos:broader" value="http://data.europa.eu/dr8/DataPolicyBusinessObject"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Golden Record" id="id-d33bf0dc4c8e4fd1bd2d9aaea9e33bd3">
      <documentation>Definition: &quot;Golden Record&quot; refers to a single, authoritative, and complete version of a data entity or a set of data that serves as the reference source for all other copies or instances of that data

Source: Eurpean Comission Data Management

Source reference: https://ec.europa.eu/research/participants/docs/h2020-funding-guide/cross-cutting-issues/open-access-data-management/open-access_en.htm

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): EU-ERS: Master Data Register. https://circabc.europa.eu/ui/group/3cc8c417-0f2a-4eb4-8ff7-10d60638446a/information

eira:iopDimension: Structural IoP

LOST view: Semantic view - Motivation

eira:iopSaliency: The Master Data ABB is a key interoperable enabler for semantic interoperability because it is a core element for digital public services enabling the reuse of relevant data such as identifiers for parties, or locations.

Identifier: http://data.europa.eu/dr8/MasterDataObject

ABB name: eira:GoldenRecord

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-01-26

dct:identifier: http://data.europa.eu/dr8/MasterDataObject

</documentation>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/GoldenRecordDataObject"/>
      <property key="dct:modified" value="2023-11-20"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/GoldenRecordDataObject"/>
      <property key="dct:type" value="egovera:GoldenRecordDataObject"/>
      <property key="dct:title" value="Golden Record"/>
      <property key="eira:definitionSource" value="Eurpean Comission Data Management"/>
      <property key="eira:definitionSourceReference" value="https://ec.europa.eu/research/participants/docs/h2020-funding-guide/cross-cutting-issues/open-access-data-management/open-access_en.htm"/>
      <property key="skos:definition" value="&quot;Golden Record&quot; refers to a single, authoritative, and complete version of a data entity or a set of data that serves as the reference source for all other copies or instances of that data"/>
      <property key="skos:example" value="The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): EU-ERS: Master Data Register. https://circabc.europa.eu/ui/group/3cc8c417-0f2a-4eb4-8ff7-10d60638446a/information"/>
      <property key="skos:note" value="In the context of data management, a Golden Record is the definitive copy of a data entity which may include customer profiles, product information, or any other type of organizational data. This record is created by integrating, cleansing, and consolidating data from various sources to ensure that it is the most reliable source of truth. The Golden Record is essential in scenarios where consistent data quality is critical, such as in customer relationship management (CRM), enterprise resource planning (ERP), or master data management (MDM) systems. It is used to provide a consistent and accurate view of data across different business units and applications, thereby reducing errors, improving decision-making, and enhancing operational efficiency."/>
      <property key="eira:concept" value="eira:ArchitectureBuildingBlock"/>
      <property key="eira:eifLayer" value="Semantic"/>
      <property key="skos:broader" value="http://data.europa.eu/dr8/DataSetCatalogueDataObject"/>
    </element>
    <element xsi:type="archimate:DataObject" name="API Catalogue" id="id-d9031115f6ca4f3ea77220f3f805fcd3">
      <documentation>Definition: API Catalogue ABB is a Data Object that corresponds to a collection of (open) software interfaces that allow data consumption by a specific digital solution

